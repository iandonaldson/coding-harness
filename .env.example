# .env.example — copy to .env and fill in real values for LOCAL development only.
# .env is gitignored. Deployed environments get secrets from <Key Vault / secret manager>,
# never from this file. Values here are placeholders — never commit real ones.

# ── Example: third-party API ────────────────────────────────────────────────
# EXAMPLE_API_KEY=<your-key>

# ── Example: cloud deployment ───────────────────────────────────────────────
# RESOURCE_GROUP=<resource-group>
# LOCATION=<region>

# ── Example: container registry ─────────────────────────────────────────────
# REGISTRY_USER=<username>
# REGISTRY_TOKEN=<token>
